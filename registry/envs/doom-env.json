{
  "id": "doom-env",
  "name": "ViZDoom Environment",
  "kind": "env",
  "version": "1.0.0",
  "description": "ViZDoom visual reinforcement learning environment for Doom scenario benchmarks.",
  "author": {
    "name": "Cameron Egbert",
    "github": "CameronEgb",
    "url": "https://github.com/CameronEgb"
  },
  "repository": "https://github.com/CameronEgb/theta-plugins",
  "license": "MIT",
  "tags": [
    "doom",
    "rl",
    "tactical",
    "gym",
    "environment"
  ],
  "target_path": "in/envs/doom",
  "releases": {
    "1.0.0": {
      "tag": "v1.0.0",
      "url": "https://raw.githubusercontent.com/CameronEgb/theta-hub/main/packages/doom_env-1.0.0.zip",
      "sha256": "a9a6806ad89876a3a04f58c3f304ed1faa75c2c372dc844a33fe9233ad412fb6",
      "published_at": "2026-10-18T19:00:00Z"
    }
  },
  "paradigms": [
    "online_rl"
  ],
  "config_path": "in/config/env/doom.yaml",
  "dependencies": {
    "components": [
      "thetalib"
    ],
    "pip": [
      "vizdoom"
    ]
  },
  "config_paths": [
    "in/config/env/doom.yaml"
  ],
  "parameter_schema": {
    "type": "object",
    "properties": {
      "monitor_metric": {
        "type": "string"
      },
      "offline_only": {
        "type": "boolean"
      },
      "preprocess_on_load": {
        "type": "boolean"
      },
      "env_id": {
        "type": "string"
      },
      "num_envs": {
        "type": "integer"
      },
      "num_steps": {
        "type": "integer"
      },
      "gamma": {
        "type": "number"
      },
      "gae_lambda": {
        "type": "number"
      },
      "rules": {
        "type": "string"
      },
      "default_plots": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}
