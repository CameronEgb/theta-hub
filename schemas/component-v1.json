{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hub.thetaide.org/schemas/component-v1.json",
  "title": "ThetaComponentManifest",
  "description": "Schema for a component published on the Theta Community Hub.",
  "type": "object",
  "required": [
    "id",
    "name",
    "kind",
    "version",
    "description",
    "author",
    "repository",
    "releases"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-_]{1,63}$",
      "description": "Unique URL-safe identifier (e.g. 'obsidian-notes' or 'cql-continuous')."
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60,
      "description": "Human-readable display name."
    },
    "kind": {
      "type": "string",
      "enum": [
        "plugin",
        "method",
        "model",
        "env",
        "experiment",
        "suite",
        "package",
        "datamodule",
        "evaluator",
        "plotter"
      ],
      "description": "Component category, including data modules, evaluators, and plotters."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$",
      "description": "Current semantic version string (e.g. '1.0.0')."
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 250,
      "description": "Clear summary of the component's functionality."
    },
    "author": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "github": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "repository": {
      "type": "string",
      "format": "uri",
      "description": "Public source repository URL."
    },
    "license": {
      "type": "string",
      "default": "MIT"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "target_path": {
      "type": "string",
      "description": "Relative target directory inside the IDE or workspace."
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "thetaide": {
          "type": "string"
        },
        "python": {
          "type": "string"
        }
      }
    },
    "icon": {
      "type": "string",
      "description": "Icon identifier or relative SVG path."
    },
    "paradigms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Learning paradigms compatible with this component (e.g. ['online_rl', 'offline_rl', 'supervised'])."
    },
    "suite": {
      "type": "string",
      "description": "ID of the package that supplies this internal component."
    },
    "hidden": {
      "type": "boolean",
      "description": "Whether normal Hub discovery omits this package-internal component."
    },
    "provides": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional component IDs installed by this package."
    },
    "test_suite": {
      "type": "object",
      "description": "Optional executable conformance cases and component configuration contracts.",
      "required": [
        "format",
        "cases"
      ],
      "properties": {
        "format": {
          "const": "theta.test-suite/v1"
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "description",
              "experiment",
              "expectation",
              "execution"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "experiment": {
                "type": "string"
              },
              "expectation": {
                "enum": [
                  "runnable",
                  "blocked"
                ]
              },
              "execution": {
                "enum": [
                  "preflight",
                  "run"
                ]
              },
              "overrides": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "blocked_reason": {
                "type": "string"
              },
              "expected_error": {
                "type": "string"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "expectation": {
                      "const": "runnable"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "execution": {
                      "const": "run"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "expectation": {
                      "const": "blocked"
                    }
                  }
                },
                "then": {
                  "required": [
                    "blocked_reason"
                  ],
                  "properties": {
                    "execution": {
                      "const": "preflight"
                    }
                  }
                }
              }
            ]
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "description",
              "config_path",
              "required"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "config_path": {
                "type": "string"
              },
              "required": {
                "type": "object",
                "minProperties": 1
              }
            }
          }
        }
      }
    },
    "releases": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "tag",
          "url"
        ],
        "properties": {
          "tag": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "sha256": {
            "type": "string",
            "pattern": "^([a-fA-F0-9]{64})?$",
            "description": "SHA-256 hash of the release archive."
          },
          "published_at": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "parameter_schema": {
      "type": "object",
      "required": [
        "type",
        "properties"
      ],
      "properties": {
        "type": {
          "const": "object"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "x-theta-domain": {
          "type": "string"
        },
        "x-theta-config-schemas": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          },
          "description": "Per-config-path JSON Schemas for components that bundle multiple profiles."
        }
      },
      "description": "JSON Schema for component parameters. Use properties for nested keys, enum for dropdown choices, x-theta-domain: model for installed model choices, and x-theta-config-schemas for profile-specific schemas."
    }
  },
  "additionalProperties": true
}
